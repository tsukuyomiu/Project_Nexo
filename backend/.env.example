# ============================================================================
# PROJETO NEXO - VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para `.env` na pasta `backend/` se desejar customizar.
# ============================================================================

# Ambiente: development | staging | production
NEXO_ENV=development
NEXO_APP_NAME="Projeto Nexo API"
NEXO_API_V1_PREFIX="/api/v1"

# Banco de Dados (SQLite local por padrão; troque por postgresql+psycopg2://... em produção)
NEXO_DATABASE_URL="sqlite:///./data/nexo.db"

# Segurança e JWT
NEXO_SECRET_KEY="nexo-super-secret-jwt-key-change-in-production-2026"
NEXO_JWT_ALGORITHM="HS256"
NEXO_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (Origens permitidas separadas por vírgula)
NEXO_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Auditoria e Logs
NEXO_AUDIT_LOG_FILE="./logs/nexo_audit.jsonl"
NEXO_ACCESS_LOG_FILE="./logs/nexo_access.jsonl"
NEXO_ERROR_LOG_FILE="./logs/nexo_errors.log"
NEXO_LOGS_PUBLIC_IN_DEV=true
