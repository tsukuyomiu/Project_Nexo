# ==============================================================================
# Nexo - Root .gitignore
# ==============================================================================

# Node / Frontend
node_modules/
dist/
dist-ssr/
.output/
.vinxi/
.tanstack/
.nitro/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python virtualenv / build
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Database / Local storage
*.sqlite3
*.db
backend/data/backups/*
!backend/data/backups/.gitkeep

# Environment variables & secrets
.env
.env.local
.env.*.local
.dev.vars

# Editor & IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# OS files
.DS_Store
Thumbs.db
desktop.ini
